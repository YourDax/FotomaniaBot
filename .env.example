# Скопируйте в .env или задайте переменные окружения вручную.
# Все значения необязательны: приложение работает и с настройками по умолчанию.

# Файл базы данных SQLite (по умолчанию backend/fotomaniabot.db)
DATABASE_URL=sqlite:///backend/fotomaniabot.db

# Адрес и порт локального сервера
APP_HOST=127.0.0.1
APP_PORT=8000
# Автоперезапуск при изменении кода (только для разработки)
APP_RELOAD=0

# CDP-endpoint уже запущенного и авторизованного Chromium с вкладкой MAX
MAX_CDP_URL=http://127.0.0.1:9222
# Каталог постоянного профиля браузера MAX
MAX_BROWSER_PROFILE_DIR=.max-browser-profile
# Сохранять HTML-снимки страницы MAX при ошибках (1 — да, 0 — нет)
MAX_SAVE_DOM_LOG=0
